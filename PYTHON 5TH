import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import linregress

def draw_plot():
    # Step 1: Load the data
    df = pd.read_csv('epa-sea-level.csv')

    # Step 2: Create the scatter plot
    plt.scatter(df['Year'], df['CSIRO Adjusted Sea Level'])

    # Step 3: Create the line of best fit for the entire dataset
    slope, intercept, r_value, p_value, std_err = linregress(df['Year'], df['CSIRO Adjusted Sea Level'])
    
    # Plot the line of best fit for the entire dataset (extending to 2050)
    years_extended = range(1880, 2051)
    plt.plot(years_extended, [slope * year + intercept for year in years_extended], label='Best Fit Line (All Data)', color='red')

    # Step 4: Create the line of best fit for data from 2000 onwards
    df_2000 = df[df['Year'] >= 2000]
    slope_2000, intercept_2000, r_value, p_value, std_err = linregress(df_2000['Year'], df_2000['CSIRO Adjusted Sea Level'])
    
    # Plot the line of best fit for the data from 2000 onwards (extending to 2050)
    plt.plot(years_extended, [slope_2000 * year + intercept_2000 for year in years_extended], label='Best Fit Line (From 2000)', color='blue')

    # Step 5: Set the labels and title
    plt.xlabel('Year')
    plt.ylabel('Sea Level (inches)')
    plt.title('Rise in Sea Level')
    
    # Step 6: Show the legend
    plt.legend()

    # Step 7: Save and show the plot
    plt.tight_layout()
    plt.savefig('sea_level_rise.png')
    plt.show()

