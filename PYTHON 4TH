import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

def load_and_clean_data():
    # Load the dataset
    df = pd.read_csv('fcc-forum-pageviews.csv', parse_dates=['date'], index_col='date')
    
    # Filter the data by removing the top and bottom 2.5% of page views
    lower_limit = df['page_views'].quantile(0.025)
    upper_limit = df['page_views'].quantile(0.975)
    df = df[(df['page_views'] >= lower_limit) & (df['page_views'] <= upper_limit)]
    
    return df

def draw_line_plot(df):
    # Create a copy of the data to avoid changing original DataFrame
    df_line = df.copy()
    
    # Draw the line plot using matplotlib
    plt.figure(figsize=(12, 6))
    plt.plot(df_line.index, df_line['page_views'], color='blue')
    plt.title('Daily freeCodeCamp Forum Page Views 5/2016-12/2019')
    plt.xlabel('Date')
    plt.ylabel('Page Views')
    plt.tight_layout()
    
    # Save the figure
    plt.savefig('line_plot.png')
    return plt

def draw_bar_plot(df):
    # Create a copy of the data to avoid changing original DataFrame
    df_bar = df.copy()
    
    # Resample the data to get average daily page views for each month, grouped by year
    df_bar['year'] = df_bar.index.year
    df_bar['month'] = df_bar.index.month
    monthly_avg = df_bar.groupby(['year', 'month'])['page_views'].mean().unstack()
    
    # Create a bar plot using matplotlib
    monthly_avg.plot(kind='bar', figsize=(12, 6))
    plt.title('Average Daily Page Views for Each Month Grouped by Year')
    plt.xlabel('Years')
    plt.ylabel('Average Page Views')
    plt.legend(title='Months', labels=['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'])
    plt.tight_layout()
    
    # Save the figure
    plt.savefig('bar_plot.png')
    return plt

def draw_box_plot(df):
    # Create a copy of the data to avoid changing original DataFrame
    df_box = df.copy()
    
    # Prepare data for the box plots
    df_box['year'] = df_box.index.year
    df_box['month'] = df_box.index.month
    
    # Set up the matplotlib figure
    plt.figure(figsize=(12, 6))
    
    # Create the first box plot (year-wise)
    plt.subplot(1, 2, 1)
    sns.boxplot(x='year', y='page_views', data=df_box)
    plt.title('Year-wise Box Plot (Trend)')
    plt.xlabel('Year')
    plt.ylabel('Page Views')
    
    # Create the second box plot (month-wise)
    plt.subplot(1, 2, 2)
    sns.boxplot(x='month', y='page_views', data=df_box)
    plt.title('Month-wise Box Plot (Seasonality)')
    plt.xlabel('Month')
    plt.ylabel('Page Views')
    plt.xticks(ticks=range(12), labels=['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'])
    
    # Adjust layout and save the figure
    plt.tight_layout()
    plt.savefig('box_plot.png')
    return plt

# Main function for testing and execution
def main():
    # Load and clean the data
    df = load_and_clean_data()

    # Generate the line plot and save it
    draw_line_plot(df)
    
    # Generate the bar plot and save it
    draw_bar_plot(df)
    
    # Generate the box plot and save it
    draw_box_plot(df)

